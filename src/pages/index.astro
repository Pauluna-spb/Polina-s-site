---
import Logo from "../components/portfolio/Logo.astro";
import ProfileCard from "../components/portfolio/ProfileCard.astro";
import Chip from "../components/portfolio/Chip.astro";
import FolderChips from "../components/portfolio/FolderChips.astro";
import Cell from "../components/portfolio/Cell.astro";
import InsightCell from "../components/portfolio/InsightCell.astro";
import CellFigma from "../components/portfolio/CellFigma.astro";
import CellIcon from "../components/portfolio/CellIcon.astro";
import CellProgress from "../components/portfolio/CellProgress.astro";
import CellNotes from "../components/portfolio/CellNotes.astro";
import ChatRagCard from "../components/external/ChatRagCard.astro";
import RagItem from "../components/external/RagItem.astro";
import WorkspaceSidebarCard from "../components/external/WorkspaceSidebarCard.astro";
import ReportCardsSet from "../components/external/ReportCardsSet.astro";
import WidgetToolSet from "../components/external/WidgetToolSet.astro";
import WidgetJiraSet from "../components/external/WidgetJiraSet.astro";
import WidgetRoo from "../components/external/WidgetRoo.astro";
import WidgetS3 from "../components/external/WidgetS3.astro";
import ToolJiraEtiquette from "../components/external/ToolJiraEtiquette.astro";
import TeamDirectoryCard from "../components/external/TeamDirectoryCard.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Polina Portfolio</title>
    <style>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        background: #f4f4f2;
        color: #0d0c0c;
      }

      main {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem;
      }

      .logo-frame {
        padding: 1.5rem 2rem;
        background: #ffffff;
        border: 1px solid #d7d4d0;
      }

      .stack {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: flex-start;
      }

      .chip-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .cells {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
      }

      .insights {
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .icon-cells {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
      }

      .progress-cells {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
      }

      .external-zone {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed #b5b1aa;
      }

      .external-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="stack">
        <div class="logo-frame">
          <Logo width={260} height={83.2} />
        </div>
        <ProfileCard />
        <div class="chip-stack">
          <Chip label="About me" />
          <Chip label="About me" forceHover={true} />
        </div>
        <FolderChips />
        <div class="cells">
          <Cell size="S" />
          <Cell size="M" />
          <Cell size="L" />
          <Cell size="L2" />
          <Cell size="XL" />
        </div>
        <div class="insights">
          <InsightCell variant="default" />
          <InsightCell variant="rag" />
        </div>
        <CellFigma />
        <div class="icon-cells">
          <CellIcon variant="default" />
          <CellIcon variant="text" />
        </div>
        <div class="progress-cells">
          <CellProgress size="M" />
          <CellProgress size="S" />
        </div>
        <CellNotes />
        <div class="external-zone">
          <ChatRagCard />
          <div class="external-list">
            <RagItem type="folder" />
            <RagItem type="file" />
          </div>
          <WorkspaceSidebarCard />
          <ReportCardsSet />
          <WidgetToolSet />
          <WidgetJiraSet />
          <WidgetRoo />
          <WidgetS3 />
          <ToolJiraEtiquette />
          <div class="cells">
            <TeamDirectoryCard size="M" />
            <TeamDirectoryCard size="S" />
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
