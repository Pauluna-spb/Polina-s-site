---
import Logo from "../components/portfolio/Logo.astro";
import ProfileCard from "../components/portfolio/ProfileCard.astro";
import Chip from "../components/portfolio/Chip.astro";
import FolderChips from "../components/portfolio/FolderChips.astro";
import Cell from "../components/portfolio/Cell.astro";
import CellFigma from "../components/portfolio/CellFigma.astro";
import CellIcon from "../components/portfolio/CellIcon.astro";
import CellNotes from "../components/portfolio/CellNotes.astro";
import CellProgress from "../components/portfolio/CellProgress.astro";
import InsightCell from "../components/portfolio/InsightCell.astro";
import CellKorea from "../components/portfolio/CellKorea.astro";
import CellCat from "../components/portfolio/CellCat.astro";

import ReportCardsFullSet from "../components/external/ReportCardsFullSet.astro";
import WorkspaceSidebarCard from "../components/external/WorkspaceSidebarCard.astro";
import ReportCardEmpty from "../components/external/ReportCardEmpty.astro";
import ChatRagCard from "../components/external/ChatRagCard.astro";
import RagItem from "../components/external/RagItem.astro";
import ToolRedisCell from "../components/external/ToolRedisCell.astro";
import ToolKafkaCell from "../components/external/ToolKafkaCell.astro";
import ToolJiraCell from "../components/external/ToolJiraCell.astro";
import ToolJiraEtiquette from "../components/external/ToolJiraEtiquette.astro";
import WidgetRoo from "../components/external/WidgetRoo.astro";
import WidgetS3 from "../components/external/WidgetS3.astro";
import "../styles/figma-colors.css";

const siteTitle = import.meta.env.PUBLIC_SITE_TITLE ?? "Polina Portfolio";
const ogPreviewUrl = "/og-preview.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/IconP.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:image" content={ogPreviewUrl} />
    <meta property="og:image:secure_url" content={ogPreviewUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:image" content={ogPreviewUrl} />
    <title>{siteTitle}</title>
    <style>
      :root {
        --layout-width: 1100px;
        --grid-gap: 10px;
        --space-xl: 80px;
        --w-310: 310px;
        --w-225: 225px;
        --w-140: 140px;
        --h-card: 232px;
      }

      body {
        margin: 0;
        background: #fdfdfd;
        color: #212121;
        font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
      }

      main {
        width: var(--layout-width);
        margin: 0 auto;
        padding: 32px 0 56px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .mail {
        font-size: 10px;
        color: #616161;
      }

      .hero {
        margin-top: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 52px;
      }

      .chips {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }

      .section {
        margin-top: 24px;
      }

      .top-block {
        position: relative;
        min-height: 716px;
        margin-bottom: var(--space-xl);
      }

      .top-grid {
        display: flex;
        gap: var(--grid-gap);
        align-items: start;
      }

      .top-grid-left {
        display: flex;
        flex-direction: column;
        gap: var(--grid-gap);
      }

      .top-grid-row {
        display: flex;
        gap: var(--grid-gap);
      }

      .top-grid-xl {
        position: absolute;
        left: 235px;
        top: 484px;
        margin: 0;
      }

      .reporting-grid {
        margin-top: 0;
        display: grid;
        grid-template-columns: 780px 310px;
        gap: var(--grid-gap);
        align-items: start;
      }

      .reporting-wr {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .reporting-wr :global(.workspace-card) {
        width: 100%;
      }

      .reporting-empty-wrap {
        margin-top: var(--grid-gap);
      }

      .reporting-left {
        display: flex;
        flex-direction: column;
        gap: var(--grid-gap);
      }

      .reporting-row {
        display: flex;
        gap: var(--grid-gap);
      }

      .full-row {
        margin-top: 10px;
      }

      .next-row {
        margin-top: var(--space-xl);
        display: flex;
        gap: var(--grid-gap);
        align-items: flex-start;
      }

      .next-row-left {
        display: flex;
        gap: var(--grid-gap);
        align-items: flex-start;
      }

      .next-row-left-col {
        display: flex;
        flex-direction: column;
        gap: var(--grid-gap);
      }

      .items-row {
        margin-top: var(--grid-gap);
        display: grid;
        grid-template-columns: repeat(5, 212px);
        gap: var(--grid-gap);
      }

      .final-case-row {
        margin-top: var(--space-xl);
        display: grid;
        grid-template-columns: var(--w-310) var(--w-310) var(--w-225) var(--w-225);
        gap: var(--grid-gap);
      }

      .next-case-layout {
        margin-top: var(--grid-gap);
        display: grid;
        grid-template-columns: var(--w-310) var(--w-310) var(--w-310) var(--w-140);
        grid-template-rows: var(--h-card) 146px;
        grid-template-areas:
          "jira roo s3 notes"
          "jira tools-left tools-right notes";
        gap: var(--grid-gap);
        align-items: start;
      }

      .next-case-jira {
        grid-area: jira;
      }

      .next-case-roo {
        grid-area: roo;
      }

      .next-case-s3 {
        grid-area: s3;
      }

      .next-case-notes {
        grid-area: notes;
      }

      .tool-stack {
        display: flex;
        flex-direction: column;
        gap: var(--grid-gap);
        align-self: start;
      }

      .tool-stack--left {
        grid-area: tools-left;
      }

      .tool-stack--right {
        grid-area: tools-right;
      }

      .tool-stack :global(.tool-jira) {
        width: 310px;
      }

      .last-row {
        margin-top: var(--space-xl);
        display: grid;
        grid-template-columns: 310px 1.486fr 1fr 1fr;
        gap: var(--grid-gap);
      }

      .last-row :global(.cell-progress) {
        width: 100%;
      }

      .last-row :global(.cell-progress__title--s) {
        width: auto;
        max-width: calc(100% - 38px);
      }

      .footer {
        margin-top: 90px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }

      .footer-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        color: #616161;
      }

      .footer-links {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #616161;
        font-size: 10px;
      }

      .footer-links a {
        color: inherit;
        text-decoration: none;
      }

      .footer-links a:hover {
        text-decoration: underline;
      }

      @media (max-width: 1160px) {
        main {
          width: auto;
          padding: 20px 16px 56px;
        }

        .reporting-grid,
        .items-row,
        .final-case-row {
          display: flex;
          flex-wrap: wrap;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header class="topbar">
        <Logo width={100} height={32} />
        <p class="mail">paulinaspp@gmail.com</p>
      </header>

      <section class="hero">
        <ProfileCard />
        <div class="chips">
          <Chip label="About me" href="#about-me" />
          <Chip label="Reporting System" href="#reporting-system" />
          <Chip label="RAG" href="#rag" />
          <Chip label="Dashboard" href="#dashboard" />
          <Chip label="Other cases" href="#other-cases" />
        </div>
      </section>

      <section id="about-me" class="section top-block">
        <div class="top-grid">
          <div class="top-grid-left">
            <div class="top-grid-row">
              <FolderChips item={{ label: "About me", href: "#about-me" }} />
              <Cell size="S" />
              <CellKorea />
            </div>
            <div class="top-grid-row top-grid-row--bottom">
              <Cell class="l2" size="L2" />
              <CellCat class="cat" />
              <Cell class="m" size="M" />
            </div>
          </div>
          <Cell class="l" size="L" />
        </div>
        <div class="top-grid-xl">
          <Cell size="XL" />
        </div>
      </section>

      <section id="reporting-system" class="reporting-grid">
        <div class="reporting-left">
          <div class="reporting-row">
            <FolderChips item={{ label: "Reporting System", href: "#reporting-system" }} />
            <InsightCell variant="default" />
            <CellFigma href="https://www.figma.com/design/i852bQ8PXlfPXboCudQ1yx/Polina%22s-Cases?node-id=0-1&t=5uTPQ5GZFhKP9bDc-1" />
          </div>
          <ReportCardsFullSet />
        </div>
        <div class="reporting-wr">
          <WorkspaceSidebarCard />
          <div class="reporting-empty-wrap">
            <ReportCardEmpty compact={true} />
          </div>
        </div>
      </section>

      <section id="rag" class="next-row">
        <div class="next-row-left">
          <div class="next-row-left-col">
            <FolderChips item={{ label: "RAG", href: "#rag" }} />
            <CellIcon variant="default" />
          </div>
          <div class="next-row-left-col">
            <InsightCell variant="rag" />
            <CellFigma href="https://www.figma.com/design/i852bQ8PXlfPXboCudQ1yx/Polina%22s-Cases?node-id=16-5739&t=5uTPQ5GZFhKP9bDc-1" />
          </div>
        </div>
        <ChatRagCard />
      </section>

      <section class="items-row">
        <RagItem type="folder" />
        <RagItem type="folder" />
        <RagItem type="folder" />
        <RagItem type="folder" />
        <RagItem type="folder" />
      </section>

      <section class="items-row">
        <RagItem type="file" iconVariant="text" name="Requirements" />
        <RagItem type="file" iconVariant="table" name="Metrics Table" />
        <RagItem type="file" iconVariant="json" name="RAG Config" />
        <RagItem type="file" iconVariant="text" name="Prompt Guide" />
        <RagItem type="file" iconVariant="table" name="Release Plan" />
      </section>

      <section id="dashboard" class="final-case-row">
        <FolderChips item={{ label: "Dashboard", href: "#dashboard" }} />
        <CellIcon variant="text" />
        <ToolRedisCell />
        <ToolKafkaCell />
      </section>

      <section class="next-case-layout">
        <div class="next-case-jira">
          <ToolJiraCell />
        </div>
        <div class="next-case-roo">
          <WidgetRoo />
        </div>
        <div class="next-case-s3">
          <WidgetS3 />
        </div>
        <div class="next-case-notes">
          <CellNotes />
        </div>
        <div class="tool-stack tool-stack--left">
          <ToolJiraEtiquette title="Carrot Cache" avatarSrc="/assets/source/Plug2.svg" />
          <ToolJiraEtiquette title="Burrow Streams" avatarSrc="/assets/source/Plug3.svg" />
        </div>
        <div class="tool-stack tool-stack--right">
          <ToolJiraEtiquette title="Fluffy Storage" avatarSrc="/assets/source/Plug4.svg" />
          <ToolJiraEtiquette title="Hop Tracker" avatarSrc="/assets/source/Plug.svg" />
        </div>
      </section>

      <section id="other-cases" class="last-row">
        <FolderChips
          items={[{ label: "In progress", href: "#other-cases" }, { label: "Other cases", href: "#other-cases" }]}
          chipGap={4}
        />
        <CellProgress size="M" title={"Team Directory\n& Access Management\nPlatform"} />
        <CellProgress size="S" title={"LinkedIn Mobile\nRedesign"} />
        <CellProgress size="S" title={"OpenFaaS"} />
      </section>

      <footer class="footer">
        <Logo width={100} height={32} />
        <div class="footer-meta">
          <p class="footer-links">
            <a href="#">Download portfolio</a>
            <span>•</span>
            <a href="https://www.linkedin.com/in/polina-elpatevskaia-3b0167198/" target="_blank" rel="noopener noreferrer">Linkedin</a>
          </p>
          <span>•</span>
          <span>paulinaspp@gmail.com</span>
          <span>•</span>
          <span>2026</span>
        </div>
      </footer>
    </main>
    <script>
      const easeInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

      const smoothScrollTo = (targetY, duration = 1100) => {
        const startY = window.scrollY;
        const distance = targetY - startY;
        let startTime = null;

        const step = (timestamp) => {
          if (!startTime) startTime = timestamp;
          const elapsed = timestamp - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = easeInOutCubic(progress);

          window.scrollTo(0, startY + distance * eased);

          if (progress < 1) {
            window.requestAnimationFrame(step);
          }
        };

        window.requestAnimationFrame(step);
      };

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (event) => {
          const hash = link.getAttribute("href");
          if (!hash || hash === "#") return;

          const target = document.querySelector(hash);
          if (!target) return;

          event.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY;
          smoothScrollTo(top, 1100);
          history.replaceState(null, "", hash);
        });
      });
    </script>
  </body>
</html>
