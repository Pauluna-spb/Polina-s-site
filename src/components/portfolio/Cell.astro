---
import "../../styles/figma-typography.css";
import "../../styles/figma-colors.css";

type CellSize = "S" | "M" | "L" | "L2" | "XL";

interface Props {
  class?: string;
  size?: CellSize;
  behanceHref?: string;
}

const {
  class: className = "",
  size = "S",
  behanceHref = "https://www.behance.net/PAULINASPP",
} = Astro.props;
---

{
  size === "S" && (
    <article class:list={["cell cell--s figma-bg-y2", className]} data-node-id="31:5117">
      <h3 class="cell__title figma-h1 figma-text-secondary">Product<br />Designer<br />@ Luxoft</h3>
      <p class="cell__caption figma-text-body figma-text-secondary">Current role</p>
      <img class="cell__luxoft" src="/assets/source/Luxoft.png" alt="Luxoft" />
    </article>
  )
}

{
  size === "M" && (
    <article class:list={["cell cell--m figma-text-contrast", className]} data-node-id="38:6268">
      <img class="cell__vector1" src="/assets/source/Vector 1.svg" alt="" aria-hidden="true" />
      <img class="cell__rocket" src="/assets/source/rocket_launch.svg" alt="" aria-hidden="true" />
      <h3 class="cell__title figma-h1 figma-text-primary">Early work</h3>
      <p class="cell__body figma-text-body figma-text-primary">
        I’ve worked on a wide range of projects early in my career: including collaborations related to SpaceX
        and the FIFA World Cup.
      </p>
    </article>
  )
}

{
  size === "L" && (
    <article class:list={["cell cell--l figma-text-primary", className]} data-node-id="38:6934">
      <img class="cell__flower" src="/assets/source/Flower.png" alt="" aria-hidden="true" />
      <a class="cell__behance-pill" href={behanceHref} target="_blank" rel="noopener noreferrer">
        <img class="cell__behance-icon" src="/assets/source/behance.png" alt="" aria-hidden="true" />
        <span class="cell__behance-text figma-text-body figma-text-secondary">Behance cases</span>
        <span class="material-symbols-rounded cell__arrow" aria-hidden="true">arrow_outward</span>
      </a>
    </article>
  )
}

{
  size === "L2" && (
    <article class:list={["cell cell--l2 figma-bg-mb-0-5", className]} data-node-id="38:7962">
      <h3 class="cell__title figma-h1 figma-text-primary">
        I use AI as part
        <br />
        of my
        <br />
        workflow - not as a trend.
      </h3>
      <img class="cell__ai" src="/assets/source/AI%20Dashboard%202.0.svg" alt="" aria-hidden="true" />
      <img class="cell__star cell__star--a" src="/assets/source/Star.svg" alt="" aria-hidden="true" />
      <img class="cell__star cell__star--b" src="/assets/source/Star.svg" alt="" aria-hidden="true" />
      <p class="cell__body figma-text-body figma-text-primary">
        I introduce it carefully, step by step, and only when it actually helps.
      </p>
      <ul class="cell__list">
        <li><span class="figma-body-2 figma-text-primary">MCP</span></li>
        <li><span class="figma-body-2 figma-text-primary">Custom agents</span></li>
        <li><span class="figma-body-2 figma-text-primary">RAG Systems</span></li>
        <li><span class="figma-body-2 figma-text-primary">“Vibe code”</span></li>
      </ul>
    </article>
  )
}

{
  size === "XL" && (
    <article class:list={["cell cell--xl figma-bg-g-0-5", className]} data-node-id="38:8009">
      <h3 class="cell__title figma-h1 figma-text-primary">Other things I do</h3>
      <p class="cell__body figma-text-body figma-text-primary">
        I work on products that are complex by nature: internal tools, data-heavy systems, access management, AI
        platforms. The kind of things that break easily if you oversimplify them.
      </p>
      <p class="cell__body figma-text-body figma-text-primary">
        <span class="figma-body-2">I also built this website myself. Designed and “vibe coded”.</span>
      </p>
      <p class="cell__body figma-text-body figma-text-primary">
        And when things get too serious, I draw small illustrations for products and hide easter eggs where I can.
      </p>
      <img class="cell__cat" src="/assets/source/CAT.svg" alt="" aria-hidden="true" />
    </article>
  )
}

<style>
  @import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:FILL@0..1");

  .cell {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .cell--s {
    width: 225px;
    height: 232px;
    border: 1px solid var(--figma-y);
    padding: 19px;
  }

  .cell--s .cell__title {
    margin: 0;
    white-space: normal;
  }

  .cell--s .cell__caption {
    margin: 0;
    position: absolute;
    left: 19px;
    bottom: 19px;
  }

  .cell__luxoft {
    width: 48px;
    height: 20px;
    object-fit: contain;
    position: absolute;
    right: 19px;
    bottom: 19px;
  }

  .cell--m {
    width: 310px;
    height: 232px;
    background: var(--figma-text-contrast);
    padding: 111px 20px 20px;
  }

  .cell__vector1 {
    position: absolute;
    left: -41px;
    top: 58px;
    width: 261px;
    height: 70px;
    object-fit: contain;
  }

  .cell__rocket {
    position: absolute;
    right: 22px;
    top: 16px;
    width: 68px;
    height: 68px;
  }

  .cell--m .cell__title,
  .cell--l2 .cell__title,
  .cell--xl .cell__title {
    margin: 0;
  }

  .cell--m .cell__body {
    margin: 6px 0 0;
    width: 274px;
  }

  .cell--l {
    width: 310px;
    height: 474px;
    background: #0f6f85;
  }

  .cell__flower {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.08);
    transform-origin: center;
  }

  .cell__behance-pill {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border-radius: 10px;
    height: 25px;
    padding: 0 8px 0 4px;
    background: var(--figma-text-contrast);
    text-decoration: none;
  }

  .cell__behance-pill:hover {
    text-decoration: none;
  }

  .cell__behance-pill:hover .cell__behance-text {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cell__behance-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .cell__arrow {
    font-family: "Material Symbols Rounded", sans-serif;
    font-size: 12px;
    line-height: 1;
    color: var(--figma-text-secondary);
    font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 20;
  }

  .cell--l2 {
    width: 225px;
    height: 474px;
    border: 1px solid var(--figma-mb-5);
    padding: 19px;
  }

  .cell__ai {
    width: 113px;
    height: 113px;
    position: absolute;
    right: 8px;
    top: 141px;
  }

  .cell__star {
    width: 24px;
    height: 24px;
    position: absolute;
  }

  .cell__star--a {
    left: 39px;
    top: 145px;
  }

  .cell__star--b {
    left: -5px;
    top: 218px;
  }

  .cell--l2 .cell__body {
    margin: 142px 0 0;
    width: 186px;
  }

  .cell__list {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cell__list li {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .cell__list li::before {
    content: "✦";
    color: var(--figma-mb-5);
    font-size: 10px;
    line-height: 1;
  }

  .cell--xl {
    width: 865px;
    height: 232px;
    border: 1px solid var(--figma-g);
    padding: 19px 19px 19px 19px;
  }

  .cell--xl .cell__title {
    margin-bottom: 6px;
  }

  .cell--xl .cell__body {
    margin: 0 0 10px;
    width: 631px;
  }

  .cell__cat {
    position: absolute;
    right: -8px;
    bottom: -9px;
    width: 320px;
    height: auto;
  }
</style>
