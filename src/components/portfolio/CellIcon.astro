---
import "../../styles/figma-typography.css";
import "../../styles/figma-colors.css";

type Variant = "default" | "text";

interface Props {
  class?: string;
  variant?: Variant;
  text?: string;
}

const {
  class: className = "",
  variant = "default",
  text = "A data-heavy dashboard built for developers to observe, analyze, and manage their tools in one place.",
} = Astro.props;
---

<article
  class:list={[
    "cell-icon",
    variant === "default" ? "cell-icon--default figma-bg-mb-4" : "cell-icon--text figma-bg-mb-0-5",
    className,
  ]}
  data-node-id={variant === "default" ? "97:9694" : "97:9696"}
>
  {
    variant === "default" ? (
      <img class="cell-icon__logo" src="/assets/source/RAG System.svg" alt="RAG System" data-name="RAG System" data-node-id="97:9681" />
    ) : (
      <p class="cell-icon__text figma-h2-1 figma-text-secondary" data-node-id="97:9991">{text}</p>
    )
  }
</article>

<style>
  .cell-icon {
    width: 310px;
    height: 232px;
    border-radius: 30px;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .cell-icon--text {
    border: 1px solid var(--figma-mb-5);
  }

  .cell-icon__logo {
    width: 161px;
    height: 161px;
    position: absolute;
    left: 74.5px;
    top: 35.5px;
    object-fit: contain;
    display: block;
  }

  .cell-icon__text {
    margin: 0;
    width: 274px;
    position: absolute;
    left: 19px;
    top: 19px;
    line-height: 1.2;
  }
</style>
