---
import "../../styles/figma-typography.css";
import "../../styles/figma-colors.css";

interface Props {
  class?: string;
  message?: string;
}

const {
  class: className = "",
  message = "There are no\nnotes yet",
} = Astro.props;
---

<article
  class:list={["cell-notes figma-bg-mb-0-5", className]}
  data-name="Cell"
  data-node-id="98:10906"
>
  <img
    class="cell-notes__paws"
    src="/Polina-s-site/assets/source/Cat step 1.svg"
    alt=""
    aria-hidden="true"
    data-name="Cat step 1"
    data-node-id="80:10560"
  />
  <p class="cell-notes__text figma-body-2 figma-text-secondary" data-node-id="80:10586">{message}</p>
</article>

<style>
  .cell-notes {
    width: 140px;
    height: 384px;
    border: 1px solid var(--figma-mb-5);
    border-radius: 30px;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .cell-notes__paws {
    position: absolute;
    right: 8px;
    bottom: 16px;
    width: 72px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .cell-notes__text {
    margin: 0;
    position: absolute;
    left: 12px;
    bottom: 32px;
    white-space: pre-line;
    line-height: 1.05;
  }
</style>
