---
interface Props {
  class?: string;
  width?: number | string;
  height?: number | string;
  label?: string;
  src?: string;
}

const {
  class: className = "",
  width = 100,
  height = 32,
  label = "Polina logo",
  src = "/assets/logo.svg",
} = Astro.props;

const toCssSize = (value: number | string) =>
  typeof value === "number" ? `${value}px` : value;
---

<img
  class:list={["logo", className]}
  src={src}
  alt={label}
  width={typeof width === "number" ? width : undefined}
  height={typeof height === "number" ? height : undefined}
  style={`width:${toCssSize(width)}; height:${toCssSize(height)};`}
/>

<style>
  .logo {
    display: block;
    max-width: 100%;
  }
</style>
