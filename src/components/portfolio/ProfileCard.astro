---
import "../../styles/figma-typography.css";
import "../../styles/figma-colors.css";

interface Props {
  class?: string;
  name?: string;
  role?: string;
  description?: string;
  location?: string;
  photoSrc?: string;
  photoAlt?: string;
  portfolioHref?: string;
  linkedinHref?: string;
}

const {
  class: className = "",
  name = "Polina Elpatevskaia",
  role = "Senior Product Designer",
  description = "I design complex products that actually get used.\nMostly in fintech, internal tools, and AI systems.",
  location = "Serbia • Open to relocation",
  photoSrc = "/Polina-s-site/assets/photo.png",
  photoAlt = "Portrait of Polina Elpatevskaia",
  portfolioHref = "#",
  linkedinHref = "https://www.linkedin.com/in/polina-elpatevskaia-3b0167198/",
} = Astro.props;

const descriptionLines = description.split("\n");
---

<article class:list={["profile-card", className]} data-name="Card" data-node-id="91:7958">
  <div class="profile-card__photo-wrap figma-surface-muted" data-name="Photo" data-node-id="25:5320">
    <img class="profile-card__photo" src={photoSrc} alt={photoAlt} />
  </div>

  <div class="profile-card__content" data-name="Name" data-node-id="26:5335">
    <div class="profile-card__text" data-name="Text" data-node-id="61:5713">
      <div class="profile-card__top" data-name="Top" data-node-id="26:5334">
        <h2 class="profile-card__name figma-h1 figma-text-primary">{name}</h2>
        <p class="profile-card__role figma-h2 figma-text-primary">{role}</p>
      </div>

      <p class="profile-card__description figma-text-body figma-text-secondary">
        {
          descriptionLines.map((line, index) => (
            <>
              {line}
              {index < descriptionLines.length - 1 && <br />}
            </>
          ))
        }
      </p>
    </div>

    <div class="profile-card__meta" data-name="Bottom" data-node-id="61:5714">
      <p class="profile-card__location figma-h2 figma-text-secondary" data-name="Location" data-node-id="26:5333">
        <span class="material-symbols-rounded" aria-hidden="true">location_on</span>
        <span>{location}</span>
      </p>

      <p class="profile-card__links figma-h2 figma-text-secondary" data-name="Links" data-node-id="61:5706">
        <img
          class="profile-card__icon"
          src="/Polina-s-site/assets/icons/download.svg"
          alt=""
          aria-hidden="true"
        />
        <a href={portfolioHref}><span class="profile-card__link-text">Download portfolio</span></a>
        <span class="profile-card__separator" aria-hidden="true">•</span>
        <a href={linkedinHref} target="_blank" rel="noopener noreferrer">
          <span class="profile-card__link-text">Linkedin</span>
          <span class="material-symbols-rounded material-symbols-rounded--small" aria-hidden="true">arrow_outward</span>
        </a>
      </p>
    </div>
  </div>
</article>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:FILL@0..1");

  .profile-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: var(--figma-text-primary);
  }

  .profile-card__photo-wrap {
    width: 149px;
    height: 149px;
    border-radius: 9999px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .profile-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .profile-card__content {
    width: 322px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .profile-card__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .profile-card__top {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 227px;
  }

  .profile-card__name {
    margin: 0;
  }

  .profile-card__role {
    margin: 0;
  }

  .profile-card__description {
    margin: 0;
  }

  .profile-card__meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .profile-card__location,
  .profile-card__links {
    margin: 0;
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }

  .profile-card__location svg,
  .profile-card__links > svg,
  .profile-card__icon,
  .material-symbols-rounded {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .profile-card__icon {
    display: block;
    margin-right: 0;
    align-self: center;
  }

  .material-symbols-rounded {
    font-family: "Material Symbols Rounded", sans-serif;
    font-size: 24px;
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    letter-spacing: normal;
    text-transform: none;
    -webkit-font-smoothing: antialiased;
    font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 24;
  }

  .profile-card__links a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .profile-card__links a:hover {
    text-decoration: none;
  }

  .profile-card__links a:hover .profile-card__link-text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .profile-card__separator {
    margin: 0 4px;
  }

  .material-symbols-rounded--small {
    font-size: 16px;
    width: 16px;
    height: 16px;
    margin-left: -2px;
    font-variation-settings: "FILL" 1, "wght" 500, "GRAD" 0, "opsz" 20;
  }

  @media (max-width: 780px) {
    .profile-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .profile-card__content {
      width: 100%;
    }
  }
</style>
