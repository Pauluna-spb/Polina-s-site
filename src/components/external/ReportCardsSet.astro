---
const filledCards = [
  { title: "Bunny Corp Q1 Performance Report", hover: false, active: false },
  { title: "Bunny Corp Q1 Performance Report", hover: true, active: false },
  { title: "Bunny Corp Q1 Performance Report", hover: false, active: true },
  { title: "Bunny Corp Q1 Performance Report", hover: true, active: true },
];

const emptyCards = [
  { hover: false, active: false },
  { hover: true, active: false },
  { hover: false, active: true },
  { hover: true, active: true },
];
---

<section class="report-set" data-name="Wr1 set" data-node-id="2:8988">
  <div class="report-set__filled">
    {
      filledCards.map((card) => (
        <article class:list={["report-card", "report-card--filled", card.hover && "is-hover", card.active && "is-active"]}>
          <div class="report-card__head">
            <div class="report-card__org">
              <span class="avatar">BC</span>
              <strong>Bunny Corp</strong>
            </div>
            <div class="report-card__actions">
              <span>☆</span>
              <span>⋮</span>
            </div>
          </div>

          <h3>{card.title}</h3>

          <div class="report-card__people" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>

          <p class="meta">
            Generated on <b>27 Nov. 2025</b><br />
            Sprint: <b>Bunny Corp 286 (latest) Mar. 1 - Mar 14</b>
          </p>

          <p class="desc">
            A cross-functional report covering growth, operations, and financial performance across Bunny Corp teams.
            Includes insights from Cute Faces Marketing, Carrot Finance, and Hopper Operations.
          </p>

          <div class="progress">
            <div class="progress__title"><span>Progress</span><span>28%</span></div>
            <div class="progress__bar"><span></span></div>
          </div>

          <div class="report-card__chips">
            <span>Retention</span>
            <span>Mobile App</span>
            <span>Security</span>
            <span>Risk</span>
          </div>

          <div class="next">
            <div class="next__line"></div>
            Next steps: Resolve missing data inputs in Meadow Analytics · Re-align campaign priorities between Cute Faces Marketing
          </div>
        </article>
      ))
    }
  </div>

  <div class="report-set__empty">
    {
      emptyCards.map((card) => (
        <article class:list={["report-card", "report-card--empty", card.hover && "is-hover", card.active && "is-active"]}>
          <div class="report-card__head">
            <div class="report-card__org">
              <span class="avatar">PH</span>
              <strong>Product Hatchery</strong>
            </div>
          </div>
          <div class="report-card__empty-row">
            <div>
              <p class="empty-text">No report yet...</p>
              <button type="button">Generate Report</button>
            </div>
            <div class="empty-illustration" aria-hidden="true"></div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .report-set {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #212121;
  }

  .report-set__filled {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .report-set__empty {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .report-card {
    background: #fff;
    border-radius: 20px;
    box-sizing: border-box;
    border: 1px solid #e0e0e0;
    box-shadow: 0 2px 6px rgba(66, 66, 66, 0.25);
  }

  .report-card.is-hover {
    box-shadow: 0 5px 9px rgba(66, 66, 66, 0.25);
  }

  .report-card.is-active {
    border-color: #e32c16;
    box-shadow: 0 2px 6px rgba(227, 44, 22, 0.25);
  }

  .report-card.is-hover.is-active {
    box-shadow: 0 5px 9px rgba(227, 44, 22, 0.25);
  }

  .report-card--filled {
    width: 440px;
    height: 346px;
    padding: 20px 24px;
    overflow: hidden;
  }

  .report-card--empty {
    width: 384px;
    min-height: 107px;
    padding: 16px;
  }

  .report-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .report-card__org {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #424242;
    color: #fafafa;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 10px;
    font-weight: 700;
  }

  .report-card__actions {
    display: inline-flex;
    gap: 8px;
    color: #616161;
    font-size: 13px;
    line-height: 1;
  }

  h3 {
    margin: 16px 0 8px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
  }

  .report-card__people {
    display: flex;
    margin-bottom: 8px;
  }

  .report-card__people span {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin-right: -4px;
    border: 1px solid #fafafa;
    background-color: #bdbdbd;
    background-image: url("/assets/source/person.svg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 16px 16px;
  }

  .meta {
    margin: 0;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .meta b {
    color: #212121;
    font-weight: 500;
  }

  .desc {
    margin: 8px 0 12px;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .progress__title {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .progress__bar {
    width: 100%;
    height: 4px;
    background: rgba(37, 40, 244, 0.4);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress__bar span {
    display: block;
    width: 28%;
    height: 100%;
    background: #2528f4;
  }

  .report-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 12px;
  }

  .report-card__chips span {
    background: #edeeff;
    color: #983af2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
  }

  .next {
    margin-top: 20px;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .next__line {
    width: 100%;
    height: 2px;
    background: #eeeeee;
    margin-bottom: 8px;
  }

  .report-card__empty-row {
    margin-top: 8px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .empty-text {
    margin: 0 0 4px;
    color: #9e9e9e;
    font-size: 14px;
    line-height: 16px;
  }

  button {
    border: 0;
    border-radius: 4px;
    height: 24px;
    padding: 0 12px;
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    text-transform: uppercase;
    color: #fafafa;
    background: linear-gradient(95deg, #e32c16 14%, #fa8c24 88%);
    box-shadow: 0 2px 6px rgba(227, 44, 22, 0.25);
  }

  .empty-illustration {
    width: 48px;
    height: 48px;
    background: url("/assets/source/Empty.svg") center / contain no-repeat;
  }

  @media (max-width: 1500px) {
    .report-set {
      flex-direction: column;
      gap: 24px;
    }
  }

  @media (max-width: 980px) {
    .report-set__filled {
      grid-template-columns: 1fr;
    }
  }
</style>
