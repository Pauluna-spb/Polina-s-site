---
---

<article class="widget-card widget-card--redis" data-name="Widget / Redis" data-node-id="80:6570">
  <header class="widget-card__head">
    <div class="tool-logo">
      <img src="/Polina-s-site/assets/source/widget/redis 1.svg" alt="Redis" />
      <strong>Redis</strong>
    </div>
    <div class="tool-actions">
      <img src="/Polina-s-site/assets/source/widget/Sours.svg" alt="" aria-hidden="true" />
      <img src="/Polina-s-site/assets/source/more_vert.svg" alt="" aria-hidden="true" />
      <img src="/Polina-s-site/assets/source/widget/drag_indicator.svg" alt="" aria-hidden="true" />
    </div>
  </header>

  <div class="redis-metrics">
    <div class="memory-ring" aria-hidden="true"></div>
    <div class="memory-meta">
      <p class="memory-percent">
        78,14%
        <span class="clear-icon" aria-hidden="true"></span>
      </p>
      <p class="memory-label">Memory usage</p>
      <p class="memory-total">759 MB / 972 MB</p>
    </div>
  </div>

  <div class="redis-event">
    <p class="redis-event__title">
      <img src="/Polina-s-site/assets/source/widget/tips_and_updates.svg" alt="" aria-hidden="true" />
      MEMORY PURGE
      <img src="/Polina-s-site/assets/source/widget/copy.svg" alt="" aria-hidden="true" />
    </p>
    <p class="redis-event__body">Ask the allocator to release memory.</p>
    <a href="#" aria-label="Learn more">Learn more</a>
  </div>
</article>

<style>
  .widget-card {
    border: 1px solid #eeeeee;
    border-radius: 10px;
    background: #ffffff;
    box-sizing: border-box;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .widget-card--redis {
    width: 225px;
    height: 232px;
    padding: 4px 0 12px;
  }

  .widget-card__head {
    height: 32px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 12px 4px 0 8px;
    box-sizing: border-box;
  }

  .tool-logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    padding: 4px 4px 4px 6px;
    border-radius: 4px;
    position: relative;
    top: 4px;
  }

  .tool-logo img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .tool-logo strong {
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    color: #212121;
  }

  .tool-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    width: 80px;
  }

  .tool-actions img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .redis-metrics {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 12px 0;
  }

  .memory-ring {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background:
      radial-gradient(circle at center, #fafafa 20px, transparent 20.5px),
      conic-gradient(#6366f1 0 78%, #e0e0e0 78% 100%);
  }

  .memory-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .memory-percent {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 20px;
    line-height: 24px;
    font-weight: 700;
    color: #6b6df2;
  }

  .clear-icon {
    width: 16px;
    height: 16px;
    display: inline-block;
    background-color: #6b6df2;
    -webkit-mask: url("/Polina-s-site/assets/source/widget/Clear.svg") center / contain no-repeat;
    mask: url("/Polina-s-site/assets/source/widget/Clear.svg") center / contain no-repeat;
  }

  .memory-label {
    margin: 0;
    font-size: 14px;
    line-height: 16px;
    font-weight: 400;
    color: #9e9e9e;
  }

  .memory-total {
    margin: 0;
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    color: #212121;
  }

  .redis-event {
    margin: 20px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .redis-event__title {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    color: #212121;
    text-transform: uppercase;
  }

  .redis-event__title img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .redis-event__body {
    margin: 0;
    max-width: 178px;
    font-size: 14px;
    line-height: 16px;
    font-weight: 400;
    color: #9e9e9e;
  }

  .redis-event a {
    color: #2528f4;
    text-decoration: none;
    font-size: 14px;
    line-height: 16px;
    font-weight: 400;
  }
</style>
