---
interface Props {
  class?: string;
  title?: string;
  orgName?: string;
  orgInitials?: string;
  generatedOn?: string;
  sprint?: string;
  description?: string;
  tags?: string[];
  nextSteps?: string;
  progress?: number;
  hover?: boolean;
  active?: boolean;
}

const {
  class: className = "",
  title = "Bunny Corp Q1 Performance Report",
  orgName = "Bunny Corp",
  orgInitials = "BC",
  generatedOn = "27 Nov. 2025",
  sprint = "Bunny Corp 286 (latest) Mar. 1 - Mar 14",
  description = "A cross-functional report covering growth, operations, and financial performance across Bunny Corp teams. Includes insights from Cute Faces Marketing, Carrot Finance, and Hopper Operations.",
  tags = ["Retention", "Mobile App", "Security", "Risk"],
  nextSteps = "Resolve missing data inputs in Meadow Analytics · Re-align campaign priorities between Cute Faces Marketing",
  progress = 28,
  hover = false,
  active = false,
} = Astro.props;

const clampedProgress = Math.max(0, Math.min(100, progress));
---

<article
  class:list={["report-card-full", hover && "is-hover", active && "is-active", className]}
  data-name="Wr1 set / item / full"
  data-node-id="100:11538"
>
  <div class="report-card-full__head">
    <div class="report-card-full__org">
      <span class="avatar">{orgInitials}</span>
      <strong>{orgName}</strong>
    </div>
    <div class="report-card-full__actions">
      <span>☆</span>
      <span>⋮</span>
    </div>
  </div>

  <h3>{title}</h3>

  <div class="report-card-full__people" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <p class="meta">
    Generated on <b>{generatedOn}</b><br />
    Sprint: <b>{sprint}</b>
  </p>

  <p class="desc">{description}</p>

  <div class="progress">
    <div class="progress__title"><span>Progress</span><span>{clampedProgress}%</span></div>
    <div class="progress__bar"><span style={`width: ${clampedProgress}%;`}></span></div>
  </div>

  <div class="report-card-full__chips">
    {
      tags.map((tag) => (
        <span>{tag}</span>
      ))
    }
  </div>

  <div class="next">
    <div class="next__line"></div>
    Next steps: {nextSteps}
  </div>
</article>

<style>
  .report-card-full {
    width: 440px;
    height: 346px;
    padding: 20px 24px;
    overflow: hidden;
    box-sizing: border-box;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    box-shadow: 0 2px 6px rgba(66, 66, 66, 0.25);
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #212121;
  }

  .report-card-full.is-hover {
    box-shadow: 0 5px 9px rgba(66, 66, 66, 0.25);
  }

  .report-card-full.is-active {
    border-color: #e32c16;
    box-shadow: 0 2px 6px rgba(227, 44, 22, 0.25);
  }

  .report-card-full.is-hover.is-active {
    box-shadow: 0 5px 9px rgba(227, 44, 22, 0.25);
  }

  .report-card-full__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .report-card-full__org {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #424242;
    color: #fafafa;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 10px;
    font-weight: 700;
  }

  .report-card-full__actions {
    display: inline-flex;
    gap: 8px;
    color: #616161;
    font-size: 13px;
    line-height: 1;
  }

  h3 {
    margin: 16px 0 8px;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
  }

  .report-card-full__people {
    display: flex;
    margin-bottom: 8px;
  }

  .report-card-full__people span {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin-right: -4px;
    border: 1px solid #fafafa;
    background-color: #bdbdbd;
    background-image: url("/assets/source/person.svg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 16px 16px;
  }

  .meta {
    margin: 0;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .meta b {
    color: #212121;
    font-weight: 500;
  }

  .desc {
    margin: 8px 0 12px;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .progress__title {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .progress__bar {
    width: 100%;
    height: 4px;
    background: rgba(37, 40, 244, 0.4);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress__bar span {
    display: block;
    height: 100%;
    background: #2528f4;
  }

  .report-card-full__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 12px;
  }

  .report-card-full__chips span {
    background: #edeeff;
    color: #983af2;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
  }

  .next {
    margin-top: 20px;
    color: #9e9e9e;
    font-size: 12px;
    line-height: 14px;
  }

  .next__line {
    width: 100%;
    height: 2px;
    background: #eeeeee;
    margin-bottom: 8px;
  }
</style>
