---
interface Ticket {
  id: string;
  estimate: string;
  priority: "high" | "normal";
  status: string;
  statusType: "progress" | "todo" | "muted";
  text: string;
}

const tickets: Ticket[] = [
  { id: "IFDEV-97", estimate: "2d 4h", priority: "normal", status: "IN PROGRESS", statusType: "progress", text: "[PEN] Jira widget loren ipsun test test test" },
  { id: "IFDEV-96", estimate: "1d", priority: "high", status: "IN PROGRESS", statusType: "progress", text: "[PEN] Update API retries for dashboard sync" },
  { id: "IFDEV-95", estimate: "4h", priority: "normal", status: "TO DO", statusType: "todo", text: "[PEN] Add empty state copy for widget panel" },
  { id: "IFDEV-94", estimate: "6h", priority: "high", status: "BLOCKED", statusType: "muted", text: "[PEN] Resolve webhook timeout issue in staging" },
  { id: "IFDEV-93", estimate: "3h", priority: "normal", status: "TEST STATUS", statusType: "muted", text: "[PEN] QA verification for Jira/Roo/S3 cards" },
  { id: "IFDEV-92", estimate: "5h", priority: "normal", status: "TO DO", statusType: "todo", text: "[PEN] Create release checklist for dashboard rollout" },
];
---

<article class="jira-cell" data-name="Widget / Jira Cell" data-node-id="80:7452">
  <header class="jira-cell__head">
    <div class="jira-logo">
      <img class="jira-logo__icon" src="/assets/source/widget/Jira.svg" alt="" aria-hidden="true" />
      <strong>Jira</strong>
    </div>
    <div class="jira-actions">
      <img src="/assets/source/more_vert.svg" alt="" aria-hidden="true" />
      <img src="/assets/source/widget/drag_indicator.svg" alt="" aria-hidden="true" />
    </div>
  </header>

  <div class="jira-filters" aria-label="Filters">
    <span>My open issues</span>
    <span>Filter_1</span>
    <span>Updated recently</span>
  </div>

  <div class="jira-tickets">
    {
      tickets.map((ticket) => (
        <article class="jira-ticket">
          <div class="jira-ticket__top">
            <div class="jira-ticket__meta">
              <span class="ticket-id">{ticket.id}</span>
              <span class="ticket-est">{ticket.estimate}</span>
              <img
                class="ticket-priority"
                src={ticket.priority === "high" ? "/assets/source/widget/jira-priority-high.svg" : "/assets/source/widget/jira-priority.svg"}
                alt=""
                aria-hidden="true"
              />
            </div>
            <span class:list={["ticket-status", `is-${ticket.statusType}`]}>{ticket.status}</span>
          </div>
          <p>{ticket.text}</p>
        </article>
      ))
    }
  </div>
</article>

<style>
  .jira-cell {
    width: 310px;
    height: 384px;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    box-sizing: border-box;
    background: #ffffff;
    overflow: hidden;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
    color: #212121;
    padding: 6px 8px 10px;
  }

  .jira-cell__head {
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .jira-logo {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .jira-logo strong {
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
  }

  .jira-logo__icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .jira-actions {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .jira-actions img {
    width: 24px;
    height: 24px;
  }

  .jira-filters {
    margin-top: 6px;
    display: flex;
    gap: 4px;
    overflow: hidden;
    white-space: nowrap;
  }

  .jira-filters span {
    background: #f5f5f5;
    border-radius: 10px;
    padding: 3px 8px;
    font-size: 11px;
    line-height: 12px;
    font-weight: 500;
  }

  .jira-tickets {
    margin-top: 8px;
    height: 325px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    overflow: hidden;
    position: relative;
  }

  .jira-ticket {
    border-radius: 10px;
    background: #fafafa;
    box-shadow: 0 2px 3px rgba(66, 66, 66, 0.2);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .jira-ticket__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .jira-ticket__meta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .ticket-id {
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: #9e9e9e;
  }

  .ticket-est {
    border-radius: 4px;
    background: #6b6df2;
    color: #fafafa;
    padding: 1px 4px;
    font-size: 8px;
    line-height: 10px;
    font-weight: 500;
  }

  .ticket-priority {
    width: 16px;
    height: 16px;
    object-fit: contain;
    display: inline-block;
  }

  .ticket-status {
    border-radius: 4px;
    padding: 2px 5px;
    font-size: 8px;
    line-height: 10px;
    font-weight: 500;
    color: #fafafa;
    white-space: nowrap;
  }

  .ticket-status.is-progress {
    background: linear-gradient(5deg, #e32c16 14%, #fa8c24 88%);
  }

  .ticket-status.is-todo {
    background: #6b6df2;
  }

  .ticket-status.is-muted {
    background: #bdbdbd;
  }

  .jira-ticket p {
    margin: 0;
    font-size: 11px;
    line-height: 13px;
  }
</style>
