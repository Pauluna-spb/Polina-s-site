---
interface TeamItem {
  code: string;
  name: string;
}

const submenuItems: TeamItem[] = [
  { code: "G&O", name: "Growth & Outreach" },
  { code: "CFM", name: "Cute Faces Marketing" },
  { code: "BC", name: "Burrow Communications" },
];

const teamItems: TeamItem[] = [
  { code: "TW", name: "Talent Warren (HR)" },
  { code: "L&C", name: "Legal & Compliance Burrow" },
  { code: "PH", name: "Product Hatchery" },
  { code: "ED", name: "Experience Design" },
  { code: "CC", name: "Customer Care Den" },
  { code: "S&F", name: "Supply & Foraging" },
  { code: "S&W", name: "Security & Watch Ears" },
  { code: "FH", name: "Innovation Lab: Fast Hops" },
  { code: "P&A", name: "Partnerships & Alliances" },
  { code: "R&D", name: "Release & Delivery Crew" },
];
---

<article class="workspace-card" data-name="CellWR" data-node-id="100:11370">
  <div class="workspace-card__scroll">
    <section class="workspace-card__top">
      <div class="sidebar-item sidebar-item--active">
        <div class="avatar avatar--active">BC</div>
        <span class="name">Bunny Corp</span>
        <span class="caret caret--up" aria-hidden="true"></span>
        <span class="slider" aria-hidden="true"></span>
      </div>

      <div class="divider" aria-hidden="true"></div>

      <div class="submenu">
        {submenuItems.map((item, index) => (
          <div class:list={["sidebar-item", index > 0 && "sidebar-item--sub"]}>
            <div class="avatar">{item.code}</div>
            <span class="name">{item.name}</span>
          </div>
        ))}
      </div>
    </section>

    {teamItems.map((item) => (
      <div class="sidebar-item">
        <div class="avatar">{item.code}</div>
        <span class="name">{item.name}</span>
      </div>
    ))}
  </div>
</article>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Roboto:wght@700&display=swap");

  .workspace-card {
    width: 310px;
    height: 474px;
    border: 1px solid #333;
    border-radius: 30px;
    background: #fafafa;
    overflow: hidden;
    box-sizing: border-box;
    position: relative;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .workspace-card__scroll {
    height: 100%;
    overflow-y: auto;
    padding: 19px 8px 8px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .workspace-card__scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .workspace-card__scroll::-webkit-scrollbar-thumb {
    background: transparent;
  }

  .workspace-card__top {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sidebar-item {
    min-height: 32px;
    padding: 4px 24px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    box-sizing: border-box;
  }

  .sidebar-item--active {
    padding-right: 16px;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: #424242;
    color: #fafafa;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 10px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .avatar--active {
    border: 2px solid #fa8c24;
  }

  .name {
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
    color: #212121;
    white-space: nowrap;
  }

  .caret {
    margin-left: auto;
    width: 12px;
    height: 7px;
    display: inline-block;
    background: #212121;
    clip-path: polygon(0 75%, 50% 0, 100% 75%, 88% 100%, 50% 38%, 12% 100%);
  }

  .caret--up {
    transform: rotate(180deg);
  }

  .slider {
    position: absolute;
    right: -8px;
    top: 50%;
    width: 4px;
    height: 32px;
    transform: translateY(-50%);
    border-radius: 4px 0 0 4px;
    background: linear-gradient(2deg, #e32c16 49%, #fa8c24 89%);
  }

  .divider {
    width: calc(100% + 16px);
    margin-left: -8px;
    height: 2px;
    background: #d2d2d2;
  }

  .submenu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 8px;
  }

  .sidebar-item--sub {
    width: 276px;
    margin-left: 12px;
    position: relative;
  }
</style>
