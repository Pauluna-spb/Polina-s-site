---
interface Props {
  title?: string;
  avatarSrc?: string;
}

const {
  title = "Jira Etiquette",
  avatarSrc = "/Polina-s-site/assets/source/Plug.svg",
} = Astro.props;
---

<article class="tool-jira" data-name="Tool" data-node-id="80:9468">
  <div class="tool-jira__left">
    <img class="avatar" src={avatarSrc} alt="" aria-hidden="true" />
    <strong>{title}</strong>
  </div>
  <div class="tool-jira__right">
    <img class="star" src="/Polina-s-site/assets/source/star_2.svg" alt="" aria-hidden="true" />
    <img src="/Polina-s-site/assets/source/more_vert.svg" alt="" aria-hidden="true" />
  </div>
</article>

<style>
  .tool-jira {
    width: 248px;
    height: 68px;
    box-sizing: border-box;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    background: #ffffff;
    padding: 12px 8px 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .tool-jira__left {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .tool-jira strong {
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
    color: #212121;
  }

  .tool-jira__right {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .star {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .tool-jira__right img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
</style>
