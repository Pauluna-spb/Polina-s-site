---
---

<article class="widget-roo" data-name="Widget / Roo" data-node-id="80:9128">
  <header class="widget-roo__head">
    <div class="widget-roo__logo">
      <img src="/Polina-s-site/assets/source/widget/Roo.svg" alt="Roo" />
      <strong>Roo Management</strong>
    </div>
    <div class="widget-roo__actions" aria-hidden="true">
      <span class="icon icon--list"></span>
      <span class="icon icon--help">?</span>
      <img src="/Polina-s-site/assets/source/widget/drag_indicator.svg" alt="" />
    </div>
  </header>

  <section class="widget-roo__content">
    <h3>Bulk Delete Old Tasks by Age</h3>

    <div class="roo-input-row">
      <label class="roo-input">
        <span>Older than (days)</span>
        <div class="roo-input__value">
          <b>29</b>
          <img class="count-icon" src="/Polina-s-site/assets/source/widget/Count.svg" alt="" aria-hidden="true" />
        </div>
      </label>

      <button class="icon-btn" type="button" aria-label="Clear">
        <img class="clear-glyph" src="/Polina-s-site/assets/source/widget/Clear-gray.svg" alt="" aria-hidden="true" />
      </button>
    </div>
  </section>

  <footer class="widget-roo__footer">
    <div>
      <p class="size">39.47 MB</p>
      <p class="label">Total Task Size</p>
    </div>
    <div class="config">
      <div class="config-top">
        <p>Regenerate<br />Roo Config file</p>
        <img src="/Polina-s-site/assets/source/widget/sync.svg" alt="" aria-hidden="true" />
      </div>
      <small>Updated 14 days ago</small>
    </div>
  </footer>
</article>

<style>
  .widget-roo {
    width: 310px;
    height: 232px;
    border: 1px solid #eeeeee;
    border-radius: 10px;
    background: #fff;
    box-sizing: border-box;
    position: relative;
    padding: 4px 8px 12px;
    font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .widget-roo__head {
    height: 32px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .widget-roo__logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    padding: 4px 4px 4px 6px;
  }

  .widget-roo__logo img { width: 24px; height: 24px; }
  .widget-roo__logo strong { font-size: 16px; line-height: 20px; font-weight: 500; color: #212121; }

  .widget-roo__actions {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .widget-roo__actions img { width: 24px; height: 24px; }

  .icon { width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; color: #9e9e9e; }
  .icon--list::before { content: "\2261"; font-size: 22px; line-height: 1; }
  .icon--help { font-size: 16px; font-weight: 700; background: #9e9e9e; color: #fafafa; border-radius: 50%; width: 22px; height: 22px; }

  .widget-roo__content { margin-top: 10px; padding-left: 4px; }
  .widget-roo__content h3 { margin: 0 0 12px; font-size: 12px; line-height: 14px; font-weight: 500; color: #212121; }

  .roo-input-row { display: flex; align-items: center; gap: 4px; }
  .roo-input {
    width: 235px;
    height: 36px;
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 24px 0 12px;
    box-sizing: border-box;
  }
  .roo-input span {
    position: absolute;
    top: -9px;
    left: 11px;
    background: #fff;
    padding: 0 4px;
    font-size: 12px;
    line-height: 14px;
    color: #9e9e9e;
  }
  .roo-input b { font-size: 14px; line-height: 16px; font-weight: 400; color: #212121; }
  .roo-input__value {
    display: inline-flex;
    align-items: center;
  }
  .count-icon {
    width: 16px;
    height: 16px;
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    object-fit: contain;
    display: inline-block;
  }
  .icon-btn {
    width: 24px;
    height: 24px;
    border: 0;
    background: transparent;
    padding: 0;
  }
  .icon-btn img { width: 24px; height: 24px; }
  .clear-glyph {
    width: 24px;
    height: 24px;
    display: block;
    object-fit: contain;
  }
  .widget-roo__footer {
    position: absolute;
    left: 12px;
    right: 8px;
    bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .size { margin: 0; font-size: 20px; line-height: 24px; font-weight: 700; color: #6b6df2; }
  .label { margin: 0; font-size: 12px; line-height: 14px; color: #9e9e9e; }

  .config {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .config-top {
    display: grid;
    grid-template-columns: auto 24px;
    align-items: center;
    gap: 4px;
  }
  .config p { margin: 0; font-size: 12px; line-height: 14px; font-weight: 500; color: #212121; }
  .config img {
    width: 24px; height: 24px; vertical-align: middle;
    filter: brightness(0) saturate(100%) invert(49%) sepia(93%) saturate(4837%) hue-rotate(231deg) brightness(98%) contrast(96%);
  }
  .config small { display: block; margin-top: 2px; font-size: 12px; line-height: 14px; color: #9e9e9e; }
</style>
